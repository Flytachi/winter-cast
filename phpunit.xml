<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="defects"
         resolveDependencies="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnRisky="true"
         failOnWarning="true">

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Psr7">
            <directory>tests/Psr7</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <php>
        <!-- php-http/psr7-integration-tests: build URIs and streams with this library's PSR-17 factory -->
        <const name="URI_FACTORY" value="Flytachi\Winter\Cast\Factory\CastFactory"/>
        <const name="STREAM_FACTORY" value="Flytachi\Winter\Cast\Factory\CastFactory"/>
    </php>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

</phpunit>
